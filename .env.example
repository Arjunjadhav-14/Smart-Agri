# Gemini API Key (get your key at https://aistudio.google.com/apikey)
# Optional: if left empty, AgriSmart AI uses smart built-in agricultural simulation data
GEMINI_API_KEY=

# Gemini Model to use (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: CEDA API Key from Ashoka University for direct mandi prices
CEDA_API_KEY=

# Port for local development server (default: 3000)
PORT=3000
